#!/usr/bin/env bash
# Unified launcher for ScrcpyMac Phone Agent plugin.
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PHONE_AGENT_ROOT="$PLUGIN_ROOT"
SERVER_DIR="$PLUGIN_ROOT/server"
PYTHON_BIN="${PHONE_AGENT_PYTHON:-python3}"

select_bundled_adb() {
  local platform=""
  local arch=""
  local candidate=""

  [[ -z "${ADB_PATH:-}" ]] || return 0

  case "$(uname -s)" in
    Darwin)
      platform="darwin"
      case "$(uname -m)" in
        arm64|aarch64) arch="arm64" ;;
        x86_64|amd64) arch="x86_64" ;;
      esac
      ;;
    Linux)
      platform="linux"
      case "$(uname -m)" in
        x86_64|amd64) arch="x86_64" ;;
      esac
      ;;
  esac

  if [[ -n "$platform" && -n "$arch" ]]; then
    candidate="$PLUGIN_ROOT/bin/$platform/$arch/adb"
    if [[ -x "$candidate" ]]; then
      export ADB_PATH="$candidate"
    fi
  fi
}

ensure_adb_for_mcp() {
  local platform=""

  select_bundled_adb
  if [[ -n "${ADB_PATH:-}" ]] || command -v adb >/dev/null 2>&1; then
    return 0
  fi
  if [[ "${PHONE_AGENT_AUTO_DOWNLOAD_ADB:-1}" == "0" ]]; then
    return 0
  fi

  case "$(uname -s)" in
    Darwin) platform="darwin" ;;
    Linux)
      case "$(uname -m)" in
        x86_64|amd64) platform="linux" ;;
      esac
      ;;
  esac

  if [[ -n "$platform" ]]; then
    echo "==> adb not found; downloading bundled platform-tools" >&2
    if ! "$PLUGIN_ROOT/scripts/download-adb.sh" "$platform" >&2; then
      echo "WARN: bundled adb download failed; phone tools will report setup guidance" >&2
    fi
    select_bundled_adb
  fi
}

ensure_plugin_runtime() {
  if [[ -z "${PHONE_AGENT_PYTHON:-}" ]]; then
    "$PLUGIN_ROOT/scripts/ensure-runtime.sh" >&2
    PYTHON_BIN="$PLUGIN_ROOT/.venv/bin/python"
  fi
}

# Locate the compiled Go server, if this install has one. Built by
# scripts/build-go.sh into bin/<platform>/<arch>/phone-agent.
GO_BINARY=""
select_go_binary() {
  local platform="" arch="" candidate=""

  if [[ -n "${PHONE_AGENT_BINARY:-}" ]]; then
    [[ -x "$PHONE_AGENT_BINARY" ]] || return 1
    GO_BINARY="$PHONE_AGENT_BINARY"
    return 0
  fi

  case "$(uname -s)" in
    Darwin) platform="darwin" ;;
    Linux) platform="linux" ;;
    *) return 1 ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch="arm64" ;;
    x86_64|amd64) arch="x86_64" ;;
    *) return 1 ;;
  esac

  candidate="$PLUGIN_ROOT/bin/$platform/$arch/phone-agent"
  [[ -x "$candidate" ]] || return 1
  GO_BINARY="$candidate"
}

select_bundled_adb

# Backend selection: auto (Go when built, else Python), or force one.
# The Go server is a drop-in replacement for the Python one; keeping both
# selectable makes A/B comparison and rollback a single env var.
backend="${PHONE_AGENT_BACKEND:-auto}"
cmd="${1:-}"

case "$backend" in
  go|auto)
    if select_go_binary; then
      [[ "$cmd" == "mcp" ]] && ensure_adb_for_mcp
      exec "$GO_BINARY" "$@"
    fi
    if [[ "$backend" == "go" ]]; then
      echo "ERROR: PHONE_AGENT_BACKEND=go but no Go binary found." >&2
      echo "       Build one with: $PLUGIN_ROOT/scripts/build-go.sh" >&2
      exit 1
    fi
    ;;
  python) ;;
  *)
    echo "ERROR: PHONE_AGENT_BACKEND must be auto, go, or python (got '$backend')" >&2
    exit 1
    ;;
esac

export PYTHONPATH="$SERVER_DIR${PYTHONPATH:+:$PYTHONPATH}"

case "$cmd" in
  mcp)
    ensure_plugin_runtime
    ensure_adb_for_mcp
    exec "$PYTHON_BIN" -m phone_agent.server
    ;;
  doctor)
    ensure_plugin_runtime
    exec "$PYTHON_BIN" -c "from phone_agent.doctor import run_doctor; import json; print(json.dumps(run_doctor(), indent=2, ensure_ascii=False))"
    ;;
  devices)
    ensure_plugin_runtime
    exec "$PYTHON_BIN" -c "from phone_agent.actions import PhoneActions; import json; print(json.dumps(PhoneActions().devices(), indent=2, ensure_ascii=False))"
    ;;
  version)
    ensure_plugin_runtime
    "$PYTHON_BIN" -c "from phone_agent import __version__; print(f'scrcpymac-phone-agent {__version__}')"
    ;;
  *)
    echo "ScrcpyMac Phone Agent" >&2
    echo "Usage: phone-agent {mcp|doctor|devices|version}" >&2
    exit 1
    ;;
esac
