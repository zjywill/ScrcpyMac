#!/usr/bin/env bash
# Unified launcher for ScrcpyMac Phone Agent plugin.
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PHONE_AGENT_ROOT="$PLUGIN_ROOT"
SERVER_DIR="$PLUGIN_ROOT/server"

if [[ -z "${ADB_PATH:-}" ]]; then
  ARCH="$(uname -m)"
  case "$ARCH" in
    arm64|aarch64) BUNDLED_ARCH="arm64" ;;
    x86_64|amd64) BUNDLED_ARCH="x86_64" ;;
    *) BUNDLED_ARCH="" ;;
  esac
  if [[ -n "$BUNDLED_ARCH" ]]; then
    CANDIDATE="$PLUGIN_ROOT/bin/darwin/$BUNDLED_ARCH/adb"
    if [[ -x "$CANDIDATE" ]]; then
      export ADB_PATH="$CANDIDATE"
    fi
  fi
fi

export PYTHONPATH="$SERVER_DIR${PYTHONPATH:+:$PYTHONPATH}"

cmd="${1:-}"
case "$cmd" in
  mcp)
    exec python3 -m phone_agent.server
    ;;
  doctor)
    exec python3 -c "from phone_agent.doctor import run_doctor; import json; print(json.dumps(run_doctor(), indent=2, ensure_ascii=False))"
    ;;
  devices)
    exec python3 -c "from phone_agent.actions import PhoneActions; import json; print(json.dumps(PhoneActions().devices(), indent=2, ensure_ascii=False))"
    ;;
  version)
    python3 -c "from phone_agent import __version__; print(f'scrcpymac-phone-agent {__version__}')"
    ;;
  *)
    echo "ScrcpyMac Phone Agent" >&2
    echo "Usage: phone-agent {mcp|doctor|devices|version}" >&2
    exit 1
    ;;
esac
